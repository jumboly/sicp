 // added instruction\n  // rest is same as before\n  perform(list(op(\"user_print\"),\n               constant(\"EC-evaluate value:\"), reg(\"val\"))),\n  go_to(label(\"read_evaluate_print_loop\")),\n      "},{"tag":"SNIPPET","latex":false,"id":5,"eval":false},{"tag":"SNIPPET","latex":false,"id":6,"eval":false,"body":"function factorial (n) {\n    return n === 1\n           ? 1\n           : factorial(n - 1) * n;\n}","output":"total pushes = 4 \nmaximum depth = 3\nEC-evaluate value:\nundefined"},{"tag":"SNIPPET","latex":false,"id":7,"eval":false,"body":"factorial(5);","output":"total pushes = 151 \nmaximum depth = 28\nEC-evaluate value:\n120"}]},{"tag":"EXERCISE","title":"Exercise 5.27","id":"#ex-5.27","child":[{"tag":"SNIPPET","latex":false,"id":8,"eval":false,"body":"function factorial(n) {\n    function iter(product, counter) {\n        return counter > n\n               ? product\n               : iter(counter * product,\n                      counter + 1);\n    }\n    return iter(1, 1);\n}"}]},{"tag":"EXERCISE","title":"Exercise 5.28","id":"#ex-5.28","child":[{"tag":"SNIPPET","latex":false,"id":9,"eval":false,"body":"function factorial(n) {\n    return n === 1 \n           ? 1\n           : factorial(n - 1) * n;\n}"},{"tag":"FIGURE","scale":"70%","src":"img_original/527table.svg","id":"#fig-"}]},{"tag":"EXERCISE","title":"Exercise 2.89","id":"#ex-2.89"},{"tag":"EXERCISE","title":"Exercise 5.29","id":"#ex-5.29","child":[{"tag":"SNIPPET","latex":false,"id":10,"eval":false,"body":"function fib(n) {\n    return n < 2 ? n : fib(n - 1) + fib(n - 2);\n}"}]},{"tag":"EXERCISE","title":"Exercise 5.30","id":"#ex-5.30","child":[{"tag":"FOOTNOTE_REF","id":"#footnote-link-4","body":"4","href":"/sicpjs/5.4.4#footnote-4"}]},{"tag":"DISPLAYFOOTNOTE","id":"#footnote-1","count":1,"href":"/sicpjs/5.4.4#footnote-link-1"},{"tag":"DISPLAYFOOTNOTE","id":"#footnote-2","count":2,"href":"/sicpjs/5.4.4#footnote-link-2"},{"tag":"DISPLAYFOOTNOTE","id":"#footnote-3","count":3,"href":"/sicpj