[{"id":"/sicpjs/2","tag":"TITLE","body":"2  Building Abstractions with Dataデータによる抽象の構築"},{"tag":"EPIGRAPH","child":[{},{},{},{},{}],"author":" Hermann Weyl, ","title":"The Mathematical Way of Thinking"},{"tag":"TEXT","id":"#p1"},{"tag":"TEXT","id":"#p2"},{"tag":"TEXT","id":"#p3"},{"tag":"TEXT","id":"#p4"},{"tag":"TEXT","id":"#p5"},{"tag":"TEXT","id":"#p6","child":[{"tag":"SNIPPET","latex":false,"id":1,"eval":true,"prependLength":0,"program":"chap=2&prgrm=PTAEGUEkGEAVQFLlAJgFBoGYFcB2BjAFwEsB7XUAG2NwFMBDAJwH19SBbAIxvpPIAp6AGlCcRADxEBPAJSgA3mlDLQjWoWyMK9UACpQ40AGpRe0FIDcaAL4ZqdJqw7dcvMrn4BGEShEBmEQAWGQsgA","body":"function linear_combination(a, b, x, y) {\n    return a * x + b * y;\n} "},{"tag":"SNIPPET","latex":false,"id":2,"eval":false,"body":"function linear_combination(a, b, x, y) {\n    return add(mul(a, x), mul(b, y));\n}"},{"tag":"FOOTNOTE_REF","id":"#footnote-link-1","body":"1","href":"/sicpjs/2#footnote-1"}]},{"tag":"TEXT","id":"#p7"},{"tag":"TEXT","id":"#p8"},{"tag":"TEXT","id":"#p9"},{"tag":"TEXT","id":"#p10"},{"tag":"DISPLAYFOOTNOTE","id":"#footnote-1","count":1,"href":"/sicpjs/2#footnote-link-1"}]