n    return multiplier(a, a, b);\n}"}]},{"tag":"EXERCISE","title":"Exercise 3.35","id":"#ex-3.35","child":[{"tag":"SNIPPET","latex":true,"eval":false,"body":"\nfunction squarer(a, b) {\n    function process_new_value() {\n        if (has_value(b)) {\n            if (get_value(b) < 0) {\n                error(get_value(b), \"square less than 0 -- squarer\");\n            } else {\n                $alternative_1$\n            }\n        } else {\n            $alternative_2$\n        }\n    }\n    function process_forget_value() {\n        $body_1$\n    }\n    function me(request) {\n        $body_2$\n    }\n    $statements$\n    return me;\n}\n      "}]},{"tag":"EXERCISE","title":"Exercise 3.36","id":"#ex-3.36","child":[{"tag":"SNIPPET","latex":false,"id":18,"eval":false,"body":"const a = make_connector();\nconst b = make_connector();\nset_value(a, 10, \"user\");"},{"tag":"SNIPPET","latex":false,"id":19,"eval":false,"body":"for_each_except(setter, inform_about_value, constraints);"}]},{"tag":"EXERCISE","title":"Exercise 3.37","id":"#ex-3.37","child":[{"tag":"SNIPPET","latex":false,"id":20,"eval":false,"body":"function celsius_fahrenheit_converter(x) {\n    return cplus(cmul(cdiv(cv(9), cv(5)), x), cv(32));\n}\n\nconst C = make_connector();    \nconst F = celsius_fahrenheit_converter(C);"},{"tag":"SNIPPET","latex":false,"id":21,"eval":false,"body":"function cplus(x, y) {\n    const z = make_connector();\n    adder(x, y, z);\n    return z;\n}"},{"tag":"FOOTNOTE_REF","id":"#footnote-link-4","body":"4","href":"/sicpjs/3.3.5#footnote-4"}],"solution":[{"tag":"SNIPPET","latex":false,"id":22,"eval":true,"prependLength":168,"program":"chap=3&prgrm=PTAEGUEkGEAVQFLlAZgHToKwChsDMBXAOwGMAXASwHsjQBbAQwGsBTAfRJqJfKoCcAFAEpQAb2yhJoADYsyoAG4NpBFqAC8oPMoDOLANwSps+RSJ5+jIvM3bpew1JlzQnIjrJ8GZsjo2giAmlpRylCUkoaUD0yNjoATzYlFRYBbgB3ZIAaaLkyFj4RcScnCjxQAQBCAAsGHSTlVQE6FiEioxKS5NV-DOTQztLzSwZrfxj8vgHByT45Aj5aCz42FgYSatWADxIWAAcyAQmCrI6Z84uSs2W6NgYAIyoCWO6WU8uPj7cPLx8dIWmTgAvqAWPY1GUKq9QJV1Jo+