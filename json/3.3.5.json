, x);\n    return x;\n} "}]},{"tag":"DISPLAYFOOTNOTE","id":"#footnote-1","count":1,"href":"/sicpjs/3.3.5#footnote-link-1"},{"tag":"DISPLAYFOOTNOTE","id":"#footnote-2","count":2,"href":"/sicpjs/3.3.5#footnote-link-2"},{"tag":"DISPLAYFOOTNOTE","id":"#footnote-3","count":3,"href":"/sicpjs/3.3.5#footnote-link-3"},{"tag":"DISPLAYFOOTNOTE","id":"#footnote-4","count":4,"href":"/sicpjs/3.3.5#footnote-link-4","child":[{"tag":"SNIPPET","latex":false,"id":23,"eval":false,"body":"v_sum(\"a\", \"b\", temp1);\nv_sum(\"c\", \"d\", temp2);\nv_prod(temp1, temp2, answer);"},{"tag":"SNIPPET","latex":false,"id":24,"eval":false,"body":"const answer = v_prod(v_sum(\"a\", \"b\"), v_sum(\"c\", \"d\"));"}]}]