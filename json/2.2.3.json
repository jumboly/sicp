NcQBzMgALDkYWdg5Mfk0KATIOAEZ+FH540AAWfgBWSSKfIA","body":"function remove(item, sequence) {\n    return filter(x => ! (x === item),\n                  sequence);\n} "}]},{"tag":"EXERCISE","title":"Exercise 2.40","id":"#ex-2.40","solution":[{"tag":"SNIPPET","latex":false,"id":50,"eval":true,"prependLength":43,"program":"chap=2&prgrm=PTAEGUEkGEAVQFLlAJgHToMwChsDMBXAOwGMAXASwHsjQBTIggWzoCcBDMugfQqK9YA3dgBsAFCKoB3ADSgAFhQDm8gJSgA3tlA7QrOmQKtakqaAB8C5fO267ugPyhGIkbft2AXKAAO7CqwS0jLuHmE6DMxsnDx8AsLipqAA1KAAjHKKKqqqANzYAL64hKSUNKBM7ADWPH4B3ADOzGJ1rOpadvqGxqAiFA1kYvJ07AAmLf5tmSPjZP7irTkh4eHDYxMB6qlrs--HaOwSCRmAQu1wbT4fAxRrLpyI5D2+wOh4dce2CcQKNdapNrbDNM9R53u+xexQfZZ1wArO+9fqDChyB+qZaCn8eSIsDguF4fg2ASMQMkrUAAFpjS-VVf3-aIgLiUDRHA2Vt1Nf4CULFhGmYcNjxjM94W6Wh10qGpCPqEtv1-QkRAEMQqyLfCmDo+iPH3Q9qNYE9WyDXDiwI1prQANjyIA","body":"function unique_pairs(n) {\n    return flatmap(i => map(j => list(i, j),\n                            enumerate_interval(1, i - 1)),\n                   enumerate_interval(1, n));\n}\nfunction prime_sum_pairs(n) {\n    return map(make_pair_sum,\n               filter(is_prime_sum,\n                      unique_pairs(n)));\n} "}]},{"tag":"EXERCISE","title":"Exercise 2.41","id":"#ex-2.41","solution":[{"tag":"SNIPPET","latex":false,"id":51,"eval":true,"prependLength":12,"program":"chap=2&-qARBRGmQnnJvnIAaoQuEEYikbpIiwOFxePw2AkxBlQL8ALTpHLw5Fkjyo6IYuLY0S4uTPIlpEmhcn0RhomKY+J0vGXVZFEqbconAjnAAecgAnldOgZbqBxSlQFL8oKNmVaIdjqdGtwyPJONxGsx9VQxI1prLdDcengKCIBE8uExGsC+gMmEMYmJRZbQAAGBkuxrqF7hpaktmgHZ7A5HE5nC45NW4bWJvUGo0mphm3FB0AANjyQA","body":"function unique_triples(n) {\n    return flatmap(i => flatmap(j => map(k => list(i, j, k),\n                                         enumerate_interval(1, j - 1)),\n                                enumerate_interval(1, i - 1)),\n                   enumerate_interval(1, n));\n}\nfunction plus(x, y) {\n    return x + y;\n}\nfunction triples_that_sum_to(s, n) {\n    return filter(items => accumulate(plus, 0, items) === s,\n                  unique_triples(n));\n} "}]},{"tag":"FIGURE","scale":"60%","src":"img_original/ch2-Z-G-23.svg","id":"#fig-2.8","captionHref":"/sicpjs/2.2.3#fig-2.8","captionName":"Figure 2.8 ","captionBody":[]},{"tag":"EXERCISE","title":"Exercise 2.42","id":"#ex-2.42","child":[{"tag":"TEXT","id":"#p18","child":[{"tag":"SNIPPET","latex":false,"id":52,"eval":true,"prependLength":12,"program":"chap=2&-F8uWyIVEQTxIJyBIy+Wa3mMYwAKyooSC7Io1M4SpVasSQJ5WttduyIrIYolUpp3Nl9r5QxGujG4UmnEWoGxZwu11u7s9fNdbw+31AAFoFg5Vtk3A7coCY+9PkcTqHLjdVm5sK6DgAOJxAA","body":"function queens(board_size) {\n    function queen_cols(k) {\n        return k === 0\n               ? list(empty_board)\n               : filter(positions => is_safe(k, positions),\n                        flatmap(rest_of_queens =>\n                                  map(new_row =>\n                                        adjoin_position(new_row, k,\n                                                        rest_of_queens),\n                                      enumerate_interval(1, board_size)),\n                                queen_cols(k - 1)));\n    }\n    return queen_cols(board_size);\n} "}]}],"solution":[{"tag":"SNIPPET","latex":false,"id":53,"eval":true,"prependLength":0,"program":"chap=2&prgrm=PTAEGUEkGEAVQFLlAJgHToMwChsDMBXAOwGMAXASwHsjQBDAEwCsqKiB9AByoGcLKaACgBOVAO4AaUCSoAbKcICmPMgEpQAb2ygdoJWQLDanOhWGCTZkeKkzZqhcrUBubAF8gA","body":"function adjoin_position(row, col, rest) {\n    return pair(pair(row, col), rest);\n} "},{"tag":"SNIPPET","latex":false,"id":54,"eval":true,"prependLength":0,"program":"chap=2&prgrm=PTAEGUEkGEAVQFLlAJgHToMwChsGMB7AOwGcAXUAUwFsAHMgTwH0AjAgQwCcATUAXlBEArgBsRAbiA","body":"const empty_board = null; "},{"tag":"SNIPPET","latex":false,"id":55,"eval":true,"prependLength":0,"program":"chap=2&","body":"function is_safe(k, positions) {\n    const first_row = head(head(positions));\n    const first_col = tail(head(positions));\n    return accumulate((pos, so_far) => {\n                         const row = head(pos);\n                         const col = tail(pos);\n                         return so_far &&\n                                first_row - first_col !==\n                                row - col &&\n                                first_row + first_col !==\n                                row + col &&\n                                first_row !== row;\n                      },\n                      true,\n                      tail(positions));\n} "},{"tag":"SNIPPET","latex":false,"id":56,"eval":true,"prependLength":52,"program":"chap=2&prgrm=PTAEGUEkGEAVQFLlAJgHToMwChsDMBXAOwGMAXASwHsjQBDAEwCsqKiB9AByoGcLKaACgBOVAO4AaUCSoAbKcICmPMgEpQAb2ygdoJWQLDanOhWGCTZkeKkzZqhcrUBubAF9cMoitCKAtpxkAJ7sAEZUdMIMoAC8oEQEsrKu+MTk1LQUPOw8dHiKggDWUtx8At7qWrrSND54ZirsomKxoAAWioyCHV2l--iBCEB5RKov4vH29SyDmZyrN4sSPFkOR5AUxT9isxoOFB2J4NaZARiITjsFQeDsDeu7IXhuo6MRRCKGIMotA8tF0a8jAsGwXDYRkgiMcxzRSMU7EcbqSiNORlE7hUw7idio6pumJyTtOBaCIuoDgUefBnkM8kKS8VEcHYj7EqA85DDCugeFWNa0CZ957jpx76a4ZomXuAAcgLYEAA","body":"// click here to see all solutions "}]},{"tag":"EXERCISE","title":"Exercise 2.43","id":"#ex-2.43","child":[{"tag":"SNIPPET","latex":false,"id":57,"eval":false,"body":"flatmap(new_row =>\n          map(rest_of_queens =>\n                adjoin_position(new_row, k, rest_of_queens),\n              queen_cols(k - 1)),\n        enumerate_interval(1, board_size));"}],"solution":[]},{"tag":"DISPLAYFOOTNOTE","id":"#footnote-1","count":1,"href":"/sicpjs/2.2.3#footnote-link-1"},{"tag":"DISPLAYFOOTNOTE","id":"#footnote-2","count":2,"href":"/sicpjs/2.2.3#footnote-link-2"},{"tag":"DISPLAYFOOTNOTE","id":"#footnote-3","count":3,"href":"/sicpjs/2.2.3#footnote-link-3"},{"tag":"DISPLAYFOOTNOTE","id":"#footnote-4","count":4,"href":"/sicpjs/2.2.3#footnote-link-4"},{"tag":"DISPLAYFOOTNOTE","id":"#footnote-5","count":5,"href":"/sicpjs/2.2.3#footnote-link-5"},{"tag":"DISPLAYFOOTNOTE","id":"#footnote-6","count":6,"href":"/sicpjs/2.2.3#footnote-link-6"},{"tag":"DISPLAYFOOTNOTE","id":"#footnote-7","count"