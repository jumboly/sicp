[{"id":"/sicpjs/1.2.3","tag":"TITLE","body":"1.2.3  Orders of Growth増加のオーダー"},{"tag":"TEXT","id":"#p1"},{"tag":"TEXT","id":"#p2"},{"tag":"TEXT","id":"#p3","child":[{"body":"\n      \\[\n      \\begin{array}{lllll}\n      k_1\\,f(n) & \\leq & R(n) & \\leq & k_2\\,f(n)\n      \\end{array}\n      \\]\n    ","tag":"LATEX"}]},{"tag":"TEXT","id":"#p4","child":[{"tag":"FOOTNOTE_REF","id":"#footnote-link-1","body":"1","href":"/sicpjs/1.2.3#footnote-1"}]},{"tag":"TEXT","id":"#p5"},{"tag":"EXERCISE","title":"Exercise 1.14","id":"#ex-1.14","solution":[{"tag":"FIGURE","scale":"70%","src":"img_javascript/ex1-14.png","id":"#fig-1.14"},{"tag":"FIGURE","scale":"70%","src":"img_javascript/cc_1.png","id":"#fig-"},{"body":"\n\t\\[\n\tT(n,1) = 2n + 1 = \\Theta(n)\n\t\\]\n      ","tag":"LATEX"},{"tag":"FIGURE","scale":"70%","src":"img_javascript/cc_2.png","id":"#fig-"},{"body":"\n\t\\[\n\tT(n,2) = \\big\\lfloor {\\frac {n} {5} } \\big\\rfloor ( T(n,1) + 1) + 2 = \\big\\lfloor {\\frac {n} {5} } \\big\\rfloor ( 2n + 2 ) + 2 = \\Theta(n^2)\n\t\\]\n      ","tag":"LATEX"},{"tag":"FIGURE","scale":"70%","src":"img_javascript/cc_3.png","id":"#fig-"},{"body":"\n\t\\[\n\tT(n,3) = \\big\\lfloor {\\frac {n} {10} } \\big\\rfloor ( T(n,2) + 1) + 2 = \\big\\lfloor {\\frac {n} {10} } \\big\\rfloor \\times \\Theta(n^2) + 2 = \\Theta(n^3)\n\t\\]\n      ","tag":"LATEX"},{"body":"\n\t\\[\n\tT(n,k) = \\big\\lfloor {\\frac {n} { \\mathbb{C}_{k} } } \\big\\rfloor ( T(n, k-1) + 1) + 2\n\t\\]\n      ","tag":"LATEX"},{"body":"\n\t\\[\n\tT(n,k)\n\t= \\big\\lfloor {\\frac {n} { \\mathbb{C}_{k} } } \\big\\rfloor ( T(n, k-1) + 1 ) + 2\n\t= \\big\\lfloor {\\frac {n} { \\mathbb{C}_{k} } } \\big\\rfloor\n\t( \\big\\lfloor {\\frac {n} { \\mathbb{C}_{k-1} }  } \\big\\rfloor\n\t(... \\big\\lfloor \\frac {n} { \\mathbb{C}_{2} } \\big\\rfloor (2n+1) ...)\n\t) + 2\n\t= \\Theta(n^k)\n\t\\]\n      ","tag":"LATEX"}]},{"tag":"EXERCISE","title":"Exercise 1.15","id":"#ex-1.15","child":[{"body":"\n      \\[\n      \\begin{array}{lll}\n      \\sin x &=& 3\\sin {\\dfrac{x}{3}}-4\\sin^3{\\dfrac{x}{3}}\n      \\end{array}\n      \\]\n    ","tag":"LATEX"},{"tag":"SNIPPET","latex":false,"id":1,"eval":true,"prependLength":5,"program":"chap=1&prgrm=PTAEGUEkGEAVQFLlARgHQCY0GYBQuAzAVwDsBjAFwEsB7E0AQwCMBnACgA8BKUAb11CDQAJwCmFIsPodQAPgC8oAAygA-KBkAuUAFoNAblwBffMXLU6oMkSajOPfkJHjJ00ACoNHg8cKlKtPQADvZ8AkJiElKg2N4yegAs3ta29oYmZgGWLFQkdgwkAOYANqIO4YKRrqAAhKBszOwFJWVyymgoXBVOTurNpd09gtohOXkNRaWgYNhcXOn4Y3YAtgwUABYA+rCQ06AY80A","body":"function cube(x) {\n    return x * x * x;\n}\nfunction p(x) {\n    return 3 * x - 4 * cube(x);\n}\nfunction sine(angle) {\n    return ! (abs(angle) > 0.1)\n           ? angle\n           : p(sine(angle / 3));\n} "}],"solution":[{"tag":"TEXT","id":"#p6"}]},{"tag":"DISPLAYFOOTNOTE","id":"#footnote-1","count":1,"href":"/sicpjs/1.2.3#footnote-link-1"}]