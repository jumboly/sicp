rand),\n                           dt * head(integrand) + initial_value,\n                           dt));\n} "}]},{"tag":"EXERCISE","title":"Exercise 3.78","id":"#ex-3.78","child":[{"body":"\n      \\[\\begin{array}{lll}\n      \\dfrac {d^{2} y}{dt^{2}}-a\\dfrac{dy}{dt}-by &=& 0\n      \\end{array}\\]\n    ","tag":"LATEX"},{"tag":"FIGURE","scale":"90%","src":"img_original/ch3-Z-G-53.svg","id":"#fig-3.35","captionHref":"/sicpjs/3.5.4#fig-3.35","captionName":"Figure 3.35 ","captionBody":[]}]},{"tag":"EXERCISE","title":"Exercise 3.79","id":"#ex-3.79"},{"tag":"FIGURE","scale":"60%","src":"img_original/ch3-Z-G-58.svg","id":"#fig-3.36","captionHref":"/sicpjs/3.5.4#fig-3.36","captionName":"Figure 3.36 ","captionBody":[]},{"tag":"EXERCISE","title":"Exercise 3.80","id":"#ex-3.80","child":[{"body":"\n      \\[\\begin{array}{lll}\n      v_{R} &=& i_{R} R\\\\[9pt]\n      v_{L} &=& L\\dfrac{di_{L}}{dt}\\\\[11pt]\n      i_{C} &=& C\\dfrac{dv_{C}}{dt}\n      \\end{array}\\]\n    ","tag":"LATEX"},{"body":"\n      \\[\\begin{array}{lll}\n      i_{R} &=& i_{L}=-i_{C}\\\\[3pt]\n      v_{C} &=& v_{L}+v_{R}\n      \\end{array}\\]\n    ","tag":"LATEX"},{"body":"\n    \\[\\begin{array}{lll}\n    \\dfrac{dv_{C}}{dt}  &=& -\\dfrac{i_{L}}{C}\\\\[11pt]\n    \\dfrac {di_{L}}{dt} &=& \\dfrac{1}{L}v_{C}-\\dfrac{R}{L}i_{L}\n    \\end{array}\\]\n    ","tag":"LATEX"},{"tag":"FIGURE","scale":"60%","src":"img_original/ch3-Z-G-59.svg","id":"#fig-3.37","captionHref":"/sicpjs/3.5.4#fig-3.37","captionName":"Figure 3.37 ","captionBody":[]},{"tag":"TEXT","id":"#p6"}]},{"tag":"SUBHEADING","id":"#h1"},{"tag":"TEXT","id":"#p7","child":[{"tag":"FOOTNOTE_REF","id":"#footnote-link-2","body":"2","href":"/sicpjs/3.5.4#footnote-2"}]},{"tag":"TEXT","id":"#p8"},{"tag":"DISPLAYFOOTNOTE","id":"#footnote-1","count":1,"href":"/sicpjs/3.5.4#footnote-link-1"},{"tag":"DISPLAYFOOTNOTE","id":"#footnote-2","count":2,"href":"/sicpjs/3.5.4#footnote-link-2"}]