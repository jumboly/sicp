[{"id":"/sicpjs/2.3.2","tag":"TITLE","body":"2.3.2  \n    \n    Example: Symbolic Differentiation\n    例：シンボリック微分"},{"tag":"TEXT","id":"#p1"},{"tag":"TEXT","id":"#p2"},{"tag":"SUBHEADING","id":"#h1"},{"tag":"TEXT","id":"#p3","child":[{"body":"\n      \\[\n      \\begin{array}{rll}\n      \\dfrac{dc}{dx}     & = & \n                         0\\quad \\text{for $c$ a constant or a variable different from $x$} \\\\[12pt]\n      \\dfrac{dx}{dx}     & = &  1  \\\\[12pt]\n      \\dfrac{d(u+v)}{dx} & = & \\dfrac{du}{dx}+\\dfrac{dv}{dx} \\\\[12pt]\n      \\dfrac{d(uv)}{dx}  & = &  u\\left( \\dfrac{dv}{dx}\\right)+v\\left(\n      \\dfrac{du}{dx}\\right)\n      \\end{array}\n      \\]\n    ","tag":"LATEX"}]},{"tag":"TEXT","id":"#p4"},{"tag":"TEXT","id":"#p5","child":[{"tag":"TABLE","child":[{"tag":"TR","child":[{"tag":"TD","child":[{"tag":"JAVASCRIPTINLINE","body":"is_variable(e)"}]},{"tag":"TD"}]},{"tag":"TR","child":[{"tag":"TD","child":[{"tag":"JAVASCRIPTINLINE","body":"is_same_variable(v1, v2)"}]},{"tag":"TD"}]},{"tag":"TR","child":[{"tag":"TD","child":[{"tag":"JAVASCRIPTINLINE","body":"is_sum(e)"}]},{"tag":"TD"}]},{"tag":"TR","child":[{"tag":"TD","child":[{"tag":"JAVASCRIPTINLINE","body":"addend(e)"}]},{"tag":"TD"}]},{"tag":"TR","child":[{"tag":"TD","child":[{"tag":"JAVASCRIPTINLINE","body":"augend(e)"}]},{"tag":"TD"}]},{"tag":"TR","child":[{"tag":"TD","child":[{"tag":"JAVASCRIPTINLINE","body":"make_sum(a1, a2)"}]},{"tag":"TD"}]},{"tag":"TR","child":[{"tag":"TD","child":[{"tag":"JAVASCRIPTINLINE","body":"is_product(e)"}]},{"tag":"TD"}]},{"tag":"TR","child":[{"tag":"TD","child":[{"tag":"JAVASCRIPTINLINE","body":"multiplier(e)"}]},{"tag":"TD"}]},{"tag":"TR","child":[{"tag":"TD","child":[{"tag":"JAVASCRIPTINLINE","body":"multiplicand(e)"}]},{"tag":"TD"}]},{"tag":"TR","child":[{"tag":"TD","child":[{"tag":"JAVASCRIPTINLINE","body":"make_product(m1, m2)"}]},{"tag":"TD"}]}]},{"tag":"SNIPPET","latex":false,"id":1,"eval":true,"prependLength":27,"program":"chap=2&prgrm=PTAEGUEkGEAV