tex":false,"id":22,"eval":false,"body":"function expand(num, den, radix) {\n    return pair(math_trunc((num * radix) / den),\n                () => expand((num * radix) % den, den, radix));\n}"}],"solution":[]},{"tag":"EXERCISE","title":"Exercise 3.59","id":"#ex-3.59","child":[{"tag":"OL","child":[{"tag":"LI"},{"tag":"LI","child":[{"tag":"SNIPPET","latex":false,"id":23,"eval":false,"body":"const exp_series = pair(1, () => integrate_series(exp_series));"},{"tag":"SNIPPET","latex":true,"eval":false,"body":"\nconst cosine_series = pair(1, $\\langle{}$??$\\rangle$);\nconst sine_series = pair(0, $\\langle{}$??$\\rangle$);\n\t"}]}]}],"solution":[{"tag":"SNIPPET","latex":false,"id":24,"eval":true,"prependLength":0,"program":"chap=3&prgrm=PTAEGUEkGEAVQFLlAZgHQFY0CYBQuAzAVwDsBjAFwEsB7E0KkigUwHMAnAQxYH0BnZuyrM+ACj4BKUAG9coeaGLlqdUAAtmAGwAOg8XwA0DFuymyFF0O2YUi7ets5V2ojZwAm+qWComjoqQBeAD51LV0XPgprTgBbHgonTS8jX0FQAGpQAEYJCQBuOQUAXyL5a1t7MJ09QxyC3FLcMjoo0Ba+fkFhPlBA0EdnUWz-INDGFg5uZi6hEVEyy0GXAAYjRcsFAL7QqJj42M5tBc3T09EADzHQUQBaK-Wzp4UJti5eATmxDtmevP-Cs9ns1WhRQHxGL8RH0Bk5VqMdgwmG9plCxBsFMthgYMZttiEkZN3jNPj0TkCLHtmHEeIdjhdEfcjBCSGiJLinnkOXl8kA","body":"function integrate_series(s) {\n    function helper(ss, iter) {\n        return pair(head(ss) / iter, () => helper(stream_tail(ss), iter + 1));\n    }\n    return helper(s, 1);\n}\n\nconst cos_series = pair(1, () => integrate_series(\n        pair(0, \n            () => stream_map(\n                    (x) => (-x), \n                    integrate_series(cos_series)))));\n                    \nconst sin_series = pair(0, () => integrate_series(\n        pair(1,\n            () => integrate_series(\n                stream_map(x => -x, sin_series)\n                ))\n        )); "}]},{"tag":"EXERCISE","title":"Exercise 3.60","id":"#ex-3.60","child":[{"tag":"SNIPPET","latex":true,"eval":false,"body":"\nfunction mul_series(s1, s2) {\n    pair($\\langle{}$??$\\rangle$, () => add_streams($\\langle{}$??$\\rangle$, $\\langle{}$??$\\rangle$));\n}\n      "}],"solution":[{"tag":"SNIPPET","latex":false,"id":25,"eval":false,"body":"function mul_series(s1, s2) {\n    return pair(head(s1) * head(s2), \n        () => add_streams(\n                mul_series(stream_tail(s1), s2), \n                scale_stream(stream_tail(s2), head(s1))));\n}"}]},{"tag":"EXERCISE","title":"Exercise 3.61","id":"#ex-3.61","solution":[{"tag":"SNIPPET","latex":false,"id":26,"eval":false,"body":"function invert_unit_series(s) {\n    return pair(1, () => stream_map(x => -x, \n                  mul_series(stream_tail(s), invert_unit_series(s))));\n}"}]},{"tag":"EXERCISE","title":"Exercise 3.62","id":"#ex-3.62"},{"tag":"DISPLAYFOOTNOTE","id":"#footnote-1","count":1,"href":"/sicpjs/3.5.2#footnote-link-1"},{"tag":"DISPLAYFOOTNOTE","id":"#footnote-2","count":2,"href":"/sicpjs/3.5.2#footnote-link-2"},{"tag":"DISPLAYFOOTNOTE","id":"#footnote-3","count":3,"href":"/sicpjs/3.5.2#footnote-link-3"},{"tag":"DISPLAYFOOTNOTE","id":"#footnote-4","count":4,"href":"/sicpjs/3.5.2#footnote-link-4"},{"tag":"DISPLAYFOOTNOTE","id":"#footnote-5","count":5,"href":"/sicpjs/3.5.2#footnote-link-5"}]